{
  "installCommand": "corepack pnpm install --no-frozen-lockfile",
  "buildCommand": "corepack pnpm exec vite build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/trpc/[...trpc].ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/assistant/digest",
      "schedule": "0 1 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/option",
      "destination": "https://100xplan.manus.space/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
