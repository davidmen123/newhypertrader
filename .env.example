# Owner key for the back office at /analytics. Required: without it the visitor
# stats, the non-default accounts and the trade-review editor stay locked for
# everyone, including you. Any long random string works.
ADMIN_KEY=

# Hyperliquid read-only live account display
# Use your real main account or sub-account address, not an API/agent wallet.
# This is the default account: the public home page always shows this one.
HYPERLIQUID_USER_ADDRESS=0x
# Optional display name for the default account (defaults to 主账户).
HYPERLIQUID_ACCOUNT_LABEL=
# Extra read-only accounts, switchable on /analytics → 账户盈亏 only.
# Format: id:address:label — comma-separated, label optional.
# e.g. HYPERLIQUID_ACCOUNTS=alt:0xabc...:二号账户,test:0xdef...:测试仓
HYPERLIQUID_ACCOUNTS=
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# Extra Hyperliquid HIP-3 perp dex names to read, comma-separated.
# The app also reads the default perp market automatically.
HYPERLIQUID_PERP_DEXS=xyz

# Existing Deribit credentials, kept only while Deribit code is still present
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Feedback widget email delivery via Resend (https://resend.com, free tier).
# Sign up with the receiving mailbox, create an API key, paste it below.
RESEND_API_KEY=
# Mailbox that receives feedback submissions.
FEEDBACK_TO=pnlnotes@gmail.com

# Visitor IP geolocation for /analytics (optional).
# Amap (高德) web-service key: https://lbs.amap.com — free tier, most accurate
# for Chinese carrier IPs. When unset, the server falls back to the free
# pconline lookup (domestic IPs) and then ip-api.com (overseas IPs).
AMAP_IP_GEO_KEY=
